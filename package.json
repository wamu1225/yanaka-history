{
  "name": "yanaka-history",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "ogp": "npx tsx scripts/generate-ogp.ts",
    "validate": "npx tsx scripts/validate-data.ts",
    "predeploy": "node ../../_pipeline/tmp-tools/predeploy-guard.mjs && npm run validate && npm run ogp && npm run build && npx tsx scripts/prerender.ts && node ../../_pipeline/tmp-tools/prerender-svg-guard.mjs dist 2",
    "deploy": "gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.9.0",
    "sharp": "^0.34.5",
    "tsx": "^4.23.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  }
}
